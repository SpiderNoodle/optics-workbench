+      '℃/min':'Celsius per Minute 摄氏度/分',
+      '%':'Percent 百分比',
+      's':'Second 秒',
+      'h':'Hour 小时',
+      'lux':'Lux 勒克斯',
+      'px':'Pixel 像素',
+      'lp/mm':'Line Pairs / mm 线对/毫米',
+      'µm/px':'Micrometer per Pixel 微米/像素',
+      'nm/%':'Nanometer per Percent 纳米/百分比',
+      'dB':'Decibel 分贝',
+      'g':'Gravity g 重力加速度',
+      'Hz/g':'Hertz per g 赫兹/克力',
+      'OD':'Optical Density 光密度',
+      'θ':'Theta 角度符号',
+      '±3σ':'±3 Sigma 三西格玛',
+      '×':'Times 倍',
+      '→':'Range 范围',
+      '—':''
+    };
+    function unitEn(u){
+      var k=(u||'').trim();
+      if(UNITS.hasOwnProperty(k)) return UNITS[k];
+      return '';
+    }
+    /* ---- 把 .spec 内 .spec-row 转换为可滑动表格 ---- */
+    function convertSpec(){
+      var specs = document.querySelectorAll('.spec');
+      for(var i=0;i<specs.length;i++){
+        var s = specs[i];
+        if(s.getAttribute('data-spec-done')) continue;
+        s.setAttribute('data-spec-done','1');
+        var rows = s.querySelectorAll(':scope > .spec-row');
+        if(!rows.length) continue;
+        /* 构建表格 */
+        var table = document.createElement('table');
+        table.className = 'spec-table';
+        var thead = document.createElement('thead');
+        thead.innerHTML = '<tr><th>符号</th><th>单位</th><th>含义 · 英文全称</th></tr>';
+        table.appendChild(thead);
+        var tbody = document.createElement('tbody');
+        for(var j=0;j<rows.length;j++){
+          var r = rows[j];
+          var k = r.querySelector('.spec-k');
+          var u = r.querySelector('.spec-u');
+          var v = r.querySelector('.spec-v');
+          var tr = document.createElement('tr');
+          var tdK = document.createElement('td'); tdK.className='spec-k'; tdK.textContent = k?k.textContent.trim():'';
+          var tdU = document.createElement('td'); tdU.className='spec-u'; tdU.textContent = u?u.textContent.trim():'';
+          var tdV = document.createElement('td'); tdV.className='spec-v';
+          if(v) tdV.innerHTML = v.innerHTML;
+          /* 单位英文全称：追加在含义列 */
+          var en = u?unitEn(u.textContent):'';
+          if(en){
+            var sp = document.createElement('span');
+            sp.className = 'spec-en-full';
+            sp.textContent = en;
+            tdV.appendChild(sp);
+          }
+          tr.appendChild(tdK); tr.appendChild(tdU); tr.appendChild(tdV);
+          tbody.appendChild(tr);
+        }
+        table.appendChild(tbody);
+        /* 包一层可滚动容器 */
+        var sc = document.createElement('div');
+        sc.className = 'spec-scroll';
+        sc.appendChild(table);
+        /* 替换原有 rows（保留标题行 .spec-h） */
+        var holder = document.createElement('div');
+        holder.appendChild(sc);
+        var head = s.querySelector(':scope > .spec-h');
+        /* 清空容器内除标题行外的内容 */
+        var children = Array.prototype.slice.call(s.children);
+        for(var c=0;c<children.length;c++){
+          if(children[c]!==head) s.removeChild(children[c]);
+        }
+        s.appendChild(sc);
+      }
+    }
+    /* ---- 随机模块换一条：简洁淡出→淡入（0.18s） ---- */
+    function setupShuffleFx(){
+      var next = document.getElementById('randNext');
+      var host = document.getElementById('randHost');
+      if(!next || !host) return;
+      next.addEventListener('click', function(){
+        if(host.__fxBusy) return;
+        host.__fxBusy = true;
+        host.style.transition = 'opacity .14s ease';
+        host.style.opacity = '0';
+        setTimeout(function(){
+          host.style.opacity = '1';
+          setTimeout(function(){ host.style.transition=''; host.__fxBusy=false; }, 160);
+        }, 150);
+      });
+    }
+    function boot(){
+      convertSpec();
+      setupShuffleFx();
+    }
+    if(document.readyState === 'loading'){
+      document.addEventListener('DOMContentLoaded', boot);
+    } else {
+      boot();
+    }
+    /* 随机面板动态加载：切换知识点后再转换新面板里的 spec */
+    var obs = new MutationObserver(function(){
+      try{ convertSpec(); }catch(e){}
+    });
+    var host = document.getElementById('randHost');
+    if(host) obs.observe(host, {childList:true, subtree:true});
+  }catch(e){
+    /* 扩展脚本出错不影响原有功能 */
+    if(window.console && console.warn) console.warn('v0.9.0 ext init:', e);
+  }
+})();
+</script>
 </body>
 </html>